# Weather API - Get free key from https://openweathermap.org/api
VITE_OPENWEATHER_API_KEY=your_openweather_api_key_here

# News API - Get free key from https://newsapi.org/
VITE_NEWS_API_KEY=your_news_api_key_here

# Exchange Rate API - Get free key from https://exchangerate-api.com/
VITE_EXCHANGE_RATE_API_KEY=your_exchange_rate_api_key_here

# Note: Fake Store API doesn't require a key
